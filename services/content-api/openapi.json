{
  "openapi": "3.1.0",
  "info": {
    "title": "Folio Content API",
    "version": "1.0.0",
    "description": "Git-backed content drafts, signed previews, and reviewed publication. JSON blocks preserve the site typography; raw HTML is not accepted."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Service liveness (does not test GitHub access)",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "security": []
      }
    },
    "/v1/schema": {
      "get": {
        "summary": "Content schema summary",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        }
      }
    },
    "/v1/openapi": {
      "get": {
        "summary": "This OpenAPI document",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        }
      }
    },
    "/v1/content": {
      "get": {
        "summary": "List content and revisions on the draft branch",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "type",
            "schema": {
              "enum": [
                "case-study",
                "blog",
                "side-project"
              ]
            }
          }
        ]
      },
      "post": {
        "summary": "Create a draft",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Content"
              }
            }
          }
        }
      }
    },
    "/v1/content/{type}/{slug}": {
      "parameters": [
        {
          "in": "path",
          "name": "type",
          "required": true,
          "schema": {
            "enum": [
              "case-study",
              "blog",
              "side-project"
            ]
          }
        },
        {
          "in": "path",
          "name": "slug",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read draft and revision",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        }
      },
      "put": {
        "summary": "Update draft with optimistic concurrency",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Update"
              }
            }
          }
        }
      }
    },
    "/v1/content/{type}/{slug}/preview": {
      "parameters": [
        {
          "in": "path",
          "name": "type",
          "required": true,
          "schema": {
            "enum": [
              "case-study",
              "blog",
              "side-project"
            ]
          }
        },
        {
          "in": "path",
          "name": "slug",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Issue an expiring browser preview link",
        "responses": {
          "200": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        }
      }
    },
    "/v1/content/{type}/{slug}/publish": {
      "parameters": [
        {
          "in": "path",
          "name": "type",
          "required": true,
          "schema": {
            "enum": [
              "case-study",
              "blog",
              "side-project"
            ]
          }
        },
        {
          "in": "path",
          "name": "slug",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Open a review PR; requires publisher key; never merges",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Revision"
              }
            }
          }
        }
      }
    },
    "/v1/images": {
      "post": {
        "summary": "Upload base64 PNG/JPEG/GIF/WebP, at most 4 MiB",
        "responses": {
          "201": {
            "description": "Success"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Revision conflict"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "base64"
                ],
                "properties": {
                  "base64": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Content": {
        "type": "object",
        "required": [
          "type",
          "slug",
          "title",
          "summary",
          "blocks"
        ],
        "properties": {
          "type": {
            "enum": [
              "case-study",
              "blog",
              "side-project"
            ]
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "maxLength": 80
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "summary": {
            "type": "string",
            "maxLength": 600
          },
          "role": {
            "type": "string"
          },
          "year": {
            "type": "string",
            "maxLength": 4
          },
          "link": {
            "type": "string"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "hero"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "heading"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "subheading"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "paragraph"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20000
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "src",
                    "alt"
                  ],
                  "properties": {
                    "type": {
                      "const": "image"
                    },
                    "src": {
                      "type": "string"
                    },
                    "alt": {
                      "type": "string"
                    },
                    "caption": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "items"
                  ],
                  "properties": {
                    "type": {
                      "const": "metrics"
                    },
                    "items": {
                      "type": "array",
                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "required": [
                          "value",
                          "label",
                          "note"
                        ],
                        "properties": {
                          "value": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "note": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "Update": {
        "type": "object",
        "required": [
          "content",
          "revision"
        ],
        "properties": {
          "content": {
            "$ref": "#/components/schemas/Content"
          },
          "revision": {
            "type": "string"
          }
        }
      },
      "Revision": {
        "type": "object",
        "required": [
          "revision"
        ],
        "properties": {
          "revision": {
            "type": "string"
          }
        }
      }
    }
  }
}
